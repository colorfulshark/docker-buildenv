#! /usr/bin/env bash

#set -x

config_path="${XDG_CONFIG_HOME:-$HOME/.config}/buildenv/projects"
template_path="${XDG_CONFIG_HOME:-$HOME/.config}/buildenv/templates"

rootfs_blacklist='.buildenv dev proc run sys tmp'
tmp_dir='/tmp/buildenv'
bootstrap_image='alpine:latest'
base_image='buildenv_base'

# find container id based on it's name
# $1: container name
# return: container id or empty string
function find_container_id() {
	local container_name=$1
	local container_id=$(docker ps -a -q -f "name=^$container_name$")
	echo $container_id
}

# start the container for project
# $1: docker image id or name
# $2: project name
# $3: extra docker run options
# $4...: mount and publish arguments, already separated into words
function start_container() {
	echo 'start container'
	local docker_image=$1
	local project_name=$2
	local extra_options=$3
	shift 3
	local username=$(id -nu)
	local container_name="${username}_${project_name}"
	# Keep the existing whitespace-separated syntax for optional arguments.
	local -a options=() run_cmd=()
	IFS=$' \t\n' read -r -d '' -a options < <(printf '%s\0' "$extra_options")
	# Privileged containers share the host's power controls. Keep the sleep
	# interface read-only without making systemd's cgroup hierarchy read-only.
	run_cmd=(docker run -dt --privileged --hostname "$project_name"
		"$@" --name "$container_name"
		"${options[@]}"
		--env container=docker
		--mount type=bind,source=/sys/power,target=/sys/power,readonly
		"$docker_image" "$DISTRO_INIT")
	local container_id=$(find_container_id $container_name)
	if [ "x$container_id" == "x" ]; then
		echo "create container $container_name now"
		container_id=$("${run_cmd[@]}")
		if [ "x$?" != "x0" ]; then
			echo "failed to create container $container_name"
			exit -1
		fi
		container_id=$(find_container_id $container_name)
		echo "container $container_name:$container_id is created"
	else
		echo "container $container_name:$container_id exists, just start it"
		docker start $container_id > /dev/null
	fi
	docker exec -it -w /root "$container_id" "${DISTRO_SHELL:-/bin/bash}"
}

# stop the container
# $1: project name
function stop_container() {
	echo 'stop container'
	local project_name=$1
	local username=$(id -nu)
	local container_name="${username}_${project_name}"
	local container_id=$(find_container_id $container_name)
	if [ "x$container_id" == "x" ]; then
		echo "container $container_name does not exist, exit"
		return -1
	fi
	echo "stop and remove container $container_name:$container_id"
	docker stop $container_id > /dev/null
	docker rm $container_id > /dev/null
}

function list_container() {
	local data="Project:Distro:Version:ContainerID:Status\n"
	while read -r name id status
	do
		project_name=${name#"$(id -nu)_"}
		load_project_metadata $project_name
		data="$data$project_name:$DISTRO_NAME:$DISTRO_VERSION:$id:$status\n"
	done <<< $(docker ps -a -f "name=^${username}" --format "{{.Names}}\t{{.ID}}\t{{.Status}}")
	printf "$data" | column -t -s:
}

function show_help() {
	echo 'A script used to start a container with custom configuration'
	echo ''
	echo 'Usage: buildenv COMMAND [PROJECT]'
	echo ''
	echo 'Commands:'
	echo 'create:    interactively create a project configuration and empty rootfs directory'
	echo 'mount:     interactively manage project volume mounts'
	echo 'port:      interactively manage project port forwarding'
	echo 'start:     start the container of this project'
	echo 'stop:      stop the container of this project'
	echo 'help:      show this help message'
	echo 'clean:     clean all files related to this project'
	echo 'init:      create system files for this project'
	echo 'status:    show status of all projects'
	echo 'template:  show all templates'
	echo 'list       list all projects'
}

function show_all_projects() {
	local data=$'Project:Distro:Version:Rootfs\n'
	for project_config in "$config_path/"*
	do
		[ -f "$project_config" ] || continue
		local p=${project_config##*/}
		load_project_metadata "$p"
		data+="$p:$DISTRO_NAME:$DISTRO_VERSION:$rootfs_dir"$'\n'
	done
	printf '%s' "$data" | column -t -s:
}

# Set REPLY without evaluating user input. Prompts also work with piped input.
function read_create_input() {
	printf '%s' "$1" >&2
	if ! IFS= read -r REPLY; then
		echo "${interactive_cancel_message:-Creation canceled.}" >&2
		return 1
	fi
}

function choose_create_option() {
	local label=$1 option answer i
	shift
	local -a choices=("$@")
	if [ "${#choices[@]}" -eq 1 ]; then
		REPLY=${choices[0]}
		printf '%s: %s\n' "$label" "$REPLY" >&2
		return 0
	fi
	printf '%s:\n' "$label" >&2
	for i in "${!choices[@]}"; do
		printf '  %d) %s\n' "$((i + 1))" "${choices[i]}" >&2
	done
	while read_create_input "Select $label (number or name): "; do
		answer=$REPLY
		for option in "${choices[@]}"; do
			if [ "$answer" == "$option" ]; then
				return 0
			fi
		done
		if [[ "$answer" =~ ^[1-9][0-9]{0,8}$ ]] && [ "$answer" -le "${#choices[@]}" ]; then
			REPLY=${choices[answer - 1]}
			return 0
		fi
		echo 'Invalid selection. Try again.' >&2
	done
	return 1
}

function directory_is_empty() (
	shopt -s nullglob dotglob
	local -a entries=("$1/"*)
	[ "${#entries[@]}" -eq 0 ]
)

function validate_create_rootfs() {
	local path=$1
	if [[ "$path" == *:* || "$path" == *$'\n'* || "$path" == *$'\r'* ]]; then
		echo 'Rootfs path must not contain colons or newlines.' >&2
		return 1
	fi
	if [ -e "$path" ] || [ -L "$path" ]; then
		if [ ! -d "$path" ] || [ ! -r "$path" ] || [ ! -w "$path" ] || [ ! -x "$path" ]; then
			echo 'Rootfs path must be an accessible, writable directory.' >&2
			return 1
		fi
		if ! directory_is_empty "$path"; then
			echo 'Rootfs directory must be empty.' >&2
			return 1
		fi
	fi
}

# Run the wizard in a subshell so its traps and template variables stay local.
function create_project() (
	local project_name=${1:-} project_config='' temp_config='' created_rootfs='' owned_lock=''
	local file id metadata distro release variant selected_distro selected_release
	local selected_template='' candidate default_rootfs rootfs_path i
	local -a ids=() distros=() releases=() variants=() choices=()
	function cleanup_create_project() {
		local status=$?
		# A published project may already be using this directory, including
		# one published by another process just before our hard link failed.
		if [ -e "$project_config" ] || [ -L "$project_config" ]; then
			created_rootfs=''
		fi
		[ -z "$temp_config" ] || rm -f -- "$temp_config"
		[ -z "$created_rootfs" ] || rmdir -- "$created_rootfs" 2>/dev/null
		[ -z "$owned_lock" ] || rmdir -- "$owned_lock" 2>/dev/null
		trap - EXIT
		exit "$status"
	}
	trap cleanup_create_project EXIT
	trap 'echo "Creation canceled." >&2; exit 130' INT
	trap 'exit 143' TERM
	get_arch
	for file in "$template_path/"*; do
		[ -f "$file" ] || continue
		id=${file##*/}
		case "$id" in debian-11 | ubuntu-12) continue ;; esac
		metadata=$(
			DISTRO_NAME='' DISTRO_VERSION='' DISTRO_VARIANT='default'
			DISTRO_TYPE='container' DISTRO_ARCHES=''
			source "$file" >/dev/null || exit 1
			[ "$DISTRO_TYPE" == 'container' ] || exit 1
			if [ -n "$DISTRO_ARCHES" ]; then
				found=0
				for arch in $DISTRO_ARCHES; do
					[ "$arch" != "$CPU_ARCH" ] || found=1
				done
				[ "$found" -eq 1 ] || exit 1
			fi
			for value in "$DISTRO_NAME" "$DISTRO_VERSION" "$DISTRO_VARIANT"; do
				[[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\t'* ]] || exit 1
			done
			printf '%s\t%s\t%s' "$DISTRO_NAME" "$DISTRO_VERSION" "$DISTRO_VARIANT"
		) || continue
		IFS=$'\t' read -r distro release variant <<< "$metadata"
		ids+=("$id") distros+=("$distro") releases+=("$release") variants+=("$variant")
	done
	if [ "${#ids[@]}" -eq 0 ]; then
		echo "No compatible container templates found in $template_path. Run install.sh to install templates." >&2
		exit 1
	fi
	while true; do
		if [ "$#" -eq 0 ]; then
			read_create_input 'Project name: ' || exit 1
			project_name=$REPLY
		fi
		if [[ ! "$project_name" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; then
			echo 'Project name must be 1-63 lowercase letters, digits or hyphens, with a letter or digit at each end.' >&2
		elif [ -e "$config_path/$project_name" ] || [ -L "$config_path/$project_name" ]; then
			echo "Project $project_name already exists; it will not be overwritten." >&2
		else
			break
		fi
		[ "$#" -eq 0 ] || exit 1
	done
	project_config="$config_path/$project_name"
	mapfile -t choices < <(printf '%s\n' "${distros[@]}" | LC_ALL=C sort -u)
	choose_create_option 'distribution' "${choices[@]}" || exit 1
	selected_distro=$REPLY
	choices=()
	for i in "${!ids[@]}"; do
		[ "${distros[i]}" != "$selected_distro" ] || choices+=("${releases[i]}")
	done
	mapfile -t choices < <(printf '%s\n' "${choices[@]}" | LC_ALL=C sort -Vu)
	choose_create_option 'release' "${choices[@]}" || exit 1
	selected_release=$REPLY
	choices=()
	for i in "${!ids[@]}"; do
		if [ "${distros[i]}" == "$selected_distro" ] && [ "${releases[i]}" == "$selected_release" ]; then
			choices+=("${variants[i]}")
		fi
	done
	mapfile -t choices < <(printf '%s\n' "${choices[@]}" | LC_ALL=C sort -u)
	choose_create_option 'variant' "${choices[@]}" || exit 1
	variant=$REPLY
	choices=()
	for i in "${!ids[@]}"; do
		if [ "${distros[i]}" == "$selected_distro" ] && [ "${releases[i]}" == "$selected_release" ] && [ "${variants[i]}" == "$variant" ]; then
			choices+=("${ids[i]}")
		fi
	done
	# Custom aliases can describe the same distribution/release/variant.
	choose_create_option 'template' "${choices[@]}" || exit 1
	selected_template=$REPLY
	default_rootfs="${XDG_DATA_HOME:-$HOME/.local/share}/buildenv/rootfs/$project_name"
	while true; do
		read_create_input "Rootfs directory [$default_rootfs]: " || exit 1
		candidate=${REPLY:-$default_rootfs}
		case "$candidate" in
			'~') candidate=$HOME ;;
			'~/'*) candidate="$HOME/${candidate:2}" ;;
		esac
		validate_create_rootfs "$candidate" || continue
		rootfs_path=$(realpath -m -- "$candidate") || continue
		validate_create_rootfs "$rootfs_path" && break
	done
	# Prepare the complete configuration before publishing it without replacement.
	mkdir -p -- "$config_path" || exit 1
	if ! mkdir -- "$config_path/.create-$project_name.lock" 2>/dev/null; then
		echo "Another process is creating project $project_name, or its creation lock is unavailable." >&2
		exit 1
	fi
	owned_lock="$config_path/.create-$project_name.lock"
	if [ -e "$project_config" ] || [ -L "$project_config" ]; then
		echo "Project $project_name already exists; it will not be overwritten." >&2
		exit 1
	fi
	temp_config=$(mktemp "$config_path/.create.XXXXXXXX") || exit 1
	{
		printf 'name=%q\ntemplate=%q\nrootfs_dir=%q\n' "$project_name" "$selected_template" "$rootfs_path"
		printf '\n# Optional volume mount arguments (Bash array)\n# volume=(-v "/path/to/source:/workspace:rw")\n\n# Optional port forwarding arguments (Bash array)\n# port=(-p "0.0.0.0:8080:80/tcp")\n\n# Optional Docker run arguments\n# extra_option=""\n'
	} > "$temp_config" || exit 1
	chmod 644 -- "$temp_config" || exit 1
	if [ ! -d "$rootfs_path" ]; then
		mkdir -p -- "$(dirname -- "$rootfs_path")" || exit 1
		if mkdir -- "$rootfs_path" 2>/dev/null; then
			created_rootfs=$rootfs_path
		elif [ ! -d "$rootfs_path" ]; then
			echo "Cannot create rootfs directory: $rootfs_path" >&2
			exit 1
		fi
	fi
	validate_create_rootfs "$rootfs_path" || exit 1
	ln -T -- "$temp_config" "$project_config" || exit 1
	created_rootfs=''
	printf 'Created project %s\nConfiguration: %s\nRootfs: %s\n' "$project_name" "$project_config" "$rootfs_path"
	printf 'Next steps:\n  buildenv init %s\n  buildenv start %s\n' "$project_name" "$project_name"
)

# Strip only our complete, unique managed block, preserving all other lines.
function strip_managed_block() {
	awk -v field="$2" '
		$0 == "# BEGIN buildenv managed " field {
			if (inside || seen++) { bad=1; exit 1 }
			inside=1; next
		}
		$0 == "# END buildenv managed " field {
			if (!inside) { bad=1; exit 1 }
			inside=0; next
		}
		!inside { print }
		END { if (inside || bad) exit 1 }
	' "$1"
}

# Both editors own these variables and use the same lock for the resolved file.
function cleanup_project_edit() {
	local status=$?
	[ -z "$snapshot" ] || rm -f -- "$snapshot"
	[ -z "$temp_config" ] || rm -f -- "$temp_config"
	[ -z "$owned_lock" ] || rmdir -- "$owned_lock" 2>/dev/null
	trap - EXIT
	exit "$status"
}

function begin_project_edit() {
	local field=$1 file
	local -a choices=()
	shift
	project_name=${1:-}
	if [ "$#" -eq 0 ]; then
		for file in "$config_path/"*; do
			[ -f "$file" ] || continue
			[[ "$file" != *$'\n'* && "$file" != *$'\r'* ]] || continue
			choices+=("${file##*/}")
		done
		if [ "${#choices[@]}" -eq 0 ]; then
			echo 'No projects found. Create one with buildenv create.' >&2
			return 1
		fi
		choose_create_option project "${choices[@]}" || return 1
		project_name=$REPLY
	fi
	if [[ -z "$project_name" || "$project_name" == */* || "$project_name" == . || "$project_name" == .. || "$project_name" == *[$'\n\r']* ]]; then
		echo 'Please specify a project configuration name, without path components.' >&2
		return 1
	fi
	project_file="$config_path/$project_name"
	if [ ! -f "$project_file" ]; then
		echo "Project $project_name does not exist." >&2
		return 1
	fi
	actual_file=$(realpath -e -- "$project_file") || return 1
	parent=$(dirname -- "$actual_file")
	if ! mkdir -- "$parent/.buildenv-${actual_file##*/}.lock" 2>/dev/null; then
		echo "Project configuration for $project_name is locked or cannot be written." >&2
		return 1
	fi
	owned_lock="$parent/.buildenv-${actual_file##*/}.lock"
	snapshot=$(mktemp "$parent/.buildenv.snapshot.XXXXXXXX") || return 1
	temp_config=$(mktemp "$parent/.buildenv.config.XXXXXXXX") || return 1
	cp -- "$actual_file" "$snapshot" || return 1
	if ! strip_managed_block "$snapshot" "$field" > "$temp_config"; then
		echo "Managed $field block markers are incomplete or ambiguous; configuration was not changed." >&2
		return 1
	fi
	load_project_config "$project_name"
}

function save_project_edit() {
	bash -n "$temp_config" || return 1
	chmod --reference="$actual_file" -- "$temp_config" || return 1
	if [ "$(realpath -e -- "$project_file")" != "$actual_file" ] || ! cmp -s -- "$actual_file" "$snapshot"; then
		echo 'Project configuration changed during editing; changes were not saved. Reopen the configuration editor.' >&2
		return 1
	fi
	mv -fT -- "$temp_config" "$actual_file" || return 1
	temp_config=''
}

# The wizard owns the mount_* arrays; update one entry only after all prompts pass.
function prompt_mount_entry() {
	local index=$1 old_source='' old_target='' old_options='rw'
	local source target options mode='rw' candidate option
	local -a other_options=() option_parts=()
	if [ "$index" -lt "${#mount_sources[@]}" ]; then
		if [ "${mount_kinds[index]}" == named ]; then
			echo 'Named volumes can be kept or deleted; only bind mounts can be edited.' >&2
			return 2
		fi
		old_source=${mount_sources[index]}
		old_target=${mount_targets[index]}
		old_options=${mount_options[index]}
	fi
	while true; do
		read_create_input "Host source path${old_source:+ [$old_source]}: " || return 1
		candidate=${REPLY:-$old_source}
		case "$candidate" in
			'~') candidate=$HOME ;;
			'~/'*) candidate="$HOME/${candidate:2}" ;;
		esac
		if [[ -z "$candidate" || "$candidate" == *[:$'\n\r']* ]]; then
			echo 'Source path is required and must not contain colons or newlines.' >&2
			continue
		fi
		if [ ! -d "$candidate" ] && [ ! -f "$candidate" ]; then
			echo 'Source must be an existing directory or regular file.' >&2
			continue
		fi
		# Preserve trailing newlines in symlink targets so validation can reject them.
		source=$(realpath -e -- "$candidate" && printf '.') || continue
		source=${source%$'\n.'}
		if [[ "$source" == *[:$'\n\r']* ]]; then
			echo 'Resolved source path must not contain colons or newlines.' >&2
			continue
		fi
		break
	done
	while true; do
		read_create_input "Container target path${old_target:+ [$old_target]}: " || return 1
		candidate=${REPLY:-$old_target}
		if [[ "$candidate" != /* || "$candidate" == *[:$'\n\r']* ]]; then
			echo 'Target must be an absolute container path without colons or newlines.' >&2
			continue
		fi
		target=$(realpath -ms -- "$candidate") || continue
		if [ "$target" == / ]; then
			echo 'The container mount target cannot be /.' >&2
			continue
		fi
		local duplicate=0 i
		for i in "${!mount_targets[@]}"; do
			if [ "$i" -ne "$index" ] && [ "${mount_targets[i]}" == "$target" ]; then
				duplicate=1
			fi
		done
		if [ "$duplicate" -eq 1 ]; then
			echo "Duplicate container mount target: $target" >&2
			continue
		fi
		break
	done
	IFS=, read -r -a option_parts <<< "$old_options"
	for option in "${option_parts[@]}"; do
		case "$option" in
			ro | rw) mode=$option ;;
			*) other_options+=("$option") ;;
		esac
	done
	while true; do
		read_create_input "Access mode (rw/ro) [$mode]: " || return 1
		candidate=${REPLY:-$mode}
		case "$candidate" in
			rw | ro) options=$candidate; break ;;
			*) echo 'Access mode must be rw or ro.' >&2 ;;
		esac
	done
	for option in "${other_options[@]}"; do options+=",$option"; done
	mount_sources[index]=$source mount_targets[index]=$target
	mount_options[index]=$options mount_kinds[index]=bind
}

function mount_project() (
	local project_name=${1:-} project_file actual_file parent owned_lock=''
	local snapshot='' temp_config='' action index i dirty=0 status
	local interactive_cancel_message='Mount configuration canceled.'
	local -a choices=() mount_sources=() mount_targets=() mount_options=() mount_kinds=()
	trap cleanup_project_edit EXIT
	trap 'echo "Mount configuration canceled." >&2; exit 130' INT
	trap 'exit 143' TERM
	begin_project_edit volume "$@" || exit 1
	parse_volume_mounts || exit 1
	while true; do
		printf '\nMounts for %s:\n' "$project_name" >&2
		choices=()
		for i in "${!mount_sources[@]}"; do
			printf '  %d) %s -> %s (%s, %s)\n' "$((i + 1))" "${mount_sources[i]}" "${mount_targets[i]}" "${mount_options[i]}" "${mount_kinds[i]}" >&2
			choices+=("$((i + 1))")
		done
		[ "${#choices[@]}" -gt 0 ] || echo '  (none)' >&2
		choose_create_option action add edit delete save quit || exit 1
		action=$REPLY
		case "$action" in
			add)
				prompt_mount_entry "${#mount_sources[@]}" || exit 1
				dirty=1
				;;
			edit | delete)
				if [ "${#choices[@]}" -eq 0 ]; then
					echo "No mounts to $action." >&2
					continue
				fi
				choose_create_option 'mount number' "${choices[@]}" || exit 1
				index=$((REPLY - 1))
				if [ "$action" == edit ]; then
					prompt_mount_entry "$index"
					status=$?
					[ "$status" -ne 2 ] || continue
					[ "$status" -eq 0 ] || exit 1
				else
					unset 'mount_sources[index]' 'mount_targets[index]' 'mount_options[index]' 'mount_kinds[index]'
					mount_sources=("${mount_sources[@]}") mount_targets=("${mount_targets[@]}")
					mount_options=("${mount_options[@]}") mount_kinds=("${mount_kinds[@]}")
				fi
				dirty=1
				;;
			save)
				if [ "$dirty" -eq 0 ]; then
					echo 'No mount changes to save.'
					exit 0
				fi
				{
					printf '# BEGIN buildenv managed volume\nunset volume\nvolume=(\n'
					for i in "${!mount_sources[@]}"; do
						printf '    -v %q\n' "${mount_sources[i]}:${mount_targets[i]}:${mount_options[i]}"
					done
					printf ')\n# END buildenv managed volume\n'
				} >> "$temp_config" || exit 1
				save_project_edit || exit 1
				printf 'Saved mounts for %s\nConfiguration: %s\n' "$project_name" "$project_file"
				printf 'New containers use these mounts on start. To apply them to an existing container:\n  buildenv restart %s\n' "$project_name"
				exit 0
				;;
			quit) echo 'Mount changes discarded.'; exit 0 ;;
		esac
	done
)

function normalize_ipv4() {
	local value=$1 octet
	local -a octets=() numbers=()
	[[ "$value" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
	IFS=. read -r -a octets <<< "$value"
	for octet in "${octets[@]}"; do
		[ "$((10#$octet))" -le 255 ] || return 1
		numbers+=("$((10#$octet))")
	done
	printf -v REPLY '%d.%d.%d.%d' "${numbers[@]}"
}

function normalize_port_number() {
	local value=$1
	[[ "$value" =~ ^[0-9]+$ ]] || return 1
	# Strip zeroes before arithmetic to avoid octal parsing or integer overflow.
	value=${value#"${value%%[!0]*}"}
	[ -n "$value" ] && [ "${#value}" -le 5 ] || return 1
	[ "$value" -le 65535 ] || return 1
	REPLY=$value
}

function decode_port_spec() {
	local spec=$1
	decoded_protocol=tcp
	if [[ "$spec" == */* ]]; then
		decoded_protocol=${spec#*/}
		spec=${spec%%/*}
	fi
	case "$decoded_protocol" in tcp | udp) ;; *) return 1 ;; esac
	if [[ "$spec" =~ ^([0-9.]+):([0-9]+):([0-9]+)$ ]]; then
		decoded_ip=${BASH_REMATCH[1]}
		decoded_host=${BASH_REMATCH[2]}
		decoded_container=${BASH_REMATCH[3]}
	elif [[ "$spec" =~ ^([0-9]+):([0-9]+)$ ]]; then
		decoded_ip='0.0.0.0'
		decoded_host=${BASH_REMATCH[1]}
		decoded_container=${BASH_REMATCH[2]}
	else
		return 1
	fi
	normalize_ipv4 "$decoded_ip" || return 1
	decoded_ip=$REPLY
	normalize_port_number "$decoded_host" || return 1
	decoded_host=$REPLY
	normalize_port_number "$decoded_container" || return 1
	decoded_container=$REPLY
}

# Only configuration conflicts are checked; Docker handles actual socket binding.
function validate_port_conflict() {
	local ip=$1 host=$2 protocol=$3 ignore=${4:--1} i
	for i in "${!port_hosts[@]}"; do
		[ "$i" -ne "$ignore" ] || continue
		if [ "${port_hosts[i]}" == "$host" ] && [ "${port_protocols[i]}" == "$protocol" ]; then
			if [ "${port_ips[i]}" == "$ip" ] || [ "${port_ips[i]}" == '0.0.0.0' ] || [ "$ip" == '0.0.0.0' ]; then
				echo "Conflicting host port mapping: $ip:$host/$protocol" >&2
				return 1
			fi
		fi
	done
}

function parse_port_mappings() {
	local i token spec decoded_ip decoded_host decoded_container decoded_protocol
	local -a arguments=("${port[@]}")
	port_ips=() port_hosts=() port_containers=() port_protocols=()
	for ((i=0; i<${#arguments[@]}; i++)); do
		token=${arguments[i]}
		case "$token" in
			-p | --publish)
				i=$((i + 1))
				if [ "$i" -ge "${#arguments[@]}" ]; then
					echo 'Missing port specification after publish flag.' >&2
					return 1
				fi
				spec=${arguments[i]}
				;;
			--publish=*) spec=${token#--publish=} ;;
			*) echo "Unsupported port argument: $token" >&2; return 1 ;;
		esac
		if ! decode_port_spec "$spec"; then
			echo "Invalid port specification: $spec. Use [IPv4:]HOST_PORT:CONTAINER_PORT[/tcp|udp], with single ports from 1 to 65535." >&2
			return 1
		fi
		validate_port_conflict "$decoded_ip" "$decoded_host" "$decoded_protocol" || return 1
		port_ips+=("$decoded_ip") port_hosts+=("$decoded_host")
		port_containers+=("$decoded_container") port_protocols+=("$decoded_protocol")
	done
}

function validate_port_environment() {
	[ "${#port_hosts[@]}" -gt 0 ] || return 0
	local i token
	local -a options=()
	IFS=$' \t\n' read -r -d '' -a options < <(printf '%s\0' "$extra_option")
	for i in "${!options[@]}"; do
		token=${options[i]}
		case "$token" in
			--network | --net)
				if [ "${options[i + 1]:-}" != host ]; then continue; fi
				;;
			--network=host | --net=host) ;;
			-p | -p?* | --publish | --publish=* | -P | -P=* | --publish-all | --publish-all=*)
				echo 'Port forwarding cannot be combined with publish flags in extra_option. Move those settings into the port array manually.' >&2
				return 1
				;;
			*) continue ;;
		esac
		echo 'Port forwarding does not work with host networking. Adjust extra_option manually or remove all port mappings.' >&2
		return 1
	done
}

function prompt_port_entry() {
	local index=$1 old_ip='0.0.0.0' old_host='' old_container='' old_protocol=tcp
	local ip host container protocol candidate
	if [ "$index" -lt "${#port_hosts[@]}" ]; then
		old_ip=${port_ips[index]} old_host=${port_hosts[index]}
		old_container=${port_containers[index]} old_protocol=${port_protocols[index]}
	fi
	while true; do
		while true; do
			read_create_input "Host IPv4 address [$old_ip]: " || return 1
			if normalize_ipv4 "${REPLY:-$old_ip}"; then ip=$REPLY; break; fi
			echo 'Enter an IPv4 address with four decimal octets from 0 to 255.' >&2
		done
		while true; do
			read_create_input "Host port${old_host:+ [$old_host]}: " || return 1
			if normalize_port_number "${REPLY:-$old_host}"; then host=$REPLY; break; fi
			echo 'Enter a single decimal port from 1 to 65535.' >&2
		done
		while true; do
			read_create_input "Container port${old_container:+ [$old_container]}: " || return 1
			if normalize_port_number "${REPLY:-$old_container}"; then container=$REPLY; break; fi
			echo 'Enter a single decimal port from 1 to 65535.' >&2
		done
		while true; do
			read_create_input "Protocol (tcp/udp) [$old_protocol]: " || return 1
			candidate=${REPLY:-$old_protocol}
			case "$candidate" in tcp | udp) protocol=$candidate; break ;; esac
			echo 'Protocol must be tcp or udp.' >&2
		done
		validate_port_conflict "$ip" "$host" "$protocol" "$index" && break
		echo 'Re-enter this mapping with a different address, host port or protocol.' >&2
	done
	port_ips[index]=$ip port_hosts[index]=$host
	port_containers[index]=$container port_protocols[index]=$protocol
}

function port_project() (
	local project_name='' project_file actual_file parent owned_lock=''
	local snapshot='' temp_config='' action index i dirty=0
	local interactive_cancel_message='Port configuration canceled.'
	local -a choices=() port_ips=() port_hosts=() port_containers=() port_protocols=()
	trap cleanup_project_edit EXIT
	trap 'echo "Port configuration canceled." >&2; exit 130' INT
	trap 'exit 143' TERM
	begin_project_edit port "$@" || exit 1
	parse_port_mappings || exit 1
	while true; do
		printf '\nPort mappings for %s:\n' "$project_name" >&2
		choices=()
		for i in "${!port_hosts[@]}"; do
			printf '  %d) %s:%s -> %s/%s\n' "$((i + 1))" "${port_ips[i]}" "${port_hosts[i]}" "${port_containers[i]}" "${port_protocols[i]}" >&2
			choices+=("$((i + 1))")
		done
		[ "${#choices[@]}" -gt 0 ] || echo '  (none)' >&2
		choose_create_option action add edit delete save quit || exit 1
		action=$REPLY
		case "$action" in
			add) prompt_port_entry "${#port_hosts[@]}" || exit 1; dirty=1 ;;
			edit | delete)
				if [ "${#choices[@]}" -eq 0 ]; then
					echo "No port mappings to $action." >&2
					continue
				fi
				choose_create_option 'mapping number' "${choices[@]}" || exit 1
				index=$((REPLY - 1))
				if [ "$action" == edit ]; then
					prompt_port_entry "$index" || exit 1
				else
					unset 'port_ips[index]' 'port_hosts[index]' 'port_containers[index]' 'port_protocols[index]'
					port_ips=("${port_ips[@]}") port_hosts=("${port_hosts[@]}")
					port_containers=("${port_containers[@]}") port_protocols=("${port_protocols[@]}")
				fi
				dirty=1
				;;
			save)
				validate_port_environment || continue
				if [ "$dirty" -eq 0 ]; then echo 'No port changes to save.'; exit 0; fi
				{
					printf '# BEGIN buildenv managed port\nunset port\nport=(\n'
					for i in "${!port_hosts[@]}"; do
						printf '    -p %q\n' "${port_ips[i]}:${port_hosts[i]}:${port_containers[i]}/${port_protocols[i]}"
					done
					printf ')\n# END buildenv managed port\n'
				} >> "$temp_config" || exit 1
				save_project_edit || exit 1
				printf 'Saved port mappings for %s\nConfiguration: %s\n' "$project_name" "$project_file"
				printf 'New containers use these ports on start. To apply them to an existing container:\n  buildenv restart %s\n' "$project_name"
				exit 0
				;;
			quit) echo 'Port changes discarded.'; exit 0 ;;
		esac
	done
)

# Load configuration separately so configuration editors do not require templates.
function load_project_config() {
	local project_name=$1
	local project_config="$config_path/$project_name"
	local volume_declaration port_declaration
	if [ "x$project_name" == "x" ]; then
		echo 'please specify a valid project'
		show_all_projects
		exit -1
	fi
	unset volume port || exit 1
	name=$project_name template='' rootfs_dir='' extra_option=''
	source "$project_config" || exit 1
	if volume_declaration=$(declare -p volume 2>/dev/null); then
		if [[ ! "$volume_declaration" =~ ^declare\ -[^[:space:]]*a[^[:space:]]*\ volume(=|$) ]]; then
			echo 'volume must be a Bash indexed array, for example: volume=(-v "/source:/workspace:rw"). Convert string configurations manually.' >&2
			exit 1
		fi
	fi
	if port_declaration=$(declare -p port 2>/dev/null); then
		if [[ ! "$port_declaration" =~ ^declare\ -[^[:space:]]*a[^[:space:]]*\ port(=|$) ]]; then
			echo 'port must be a Bash indexed array, for example: port=(-p "0.0.0.0:8080:80/tcp").' >&2
			exit 1
		fi
	fi
	# Copy even arrays declared locally by a sourced configuration to global scope.
	local -a loaded_volume=("${volume[@]}")
	local -a loaded_port=("${port[@]}")
	unset volume port || exit 1
	declare -ga volume=("${loaded_volume[@]}")
	declare -ga port=("${loaded_port[@]}")
}

# Parse the supported array syntax for the wizard and rootfs override handling.
# The caller owns mount_sources, mount_targets, mount_options and mount_kinds.
function parse_volume_mounts() {
	local i token spec source target options other
	mount_sources=() mount_targets=() mount_options=() mount_kinds=()
	local -a arguments=("${volume[@]}")
	for ((i=0; i<${#arguments[@]}; i++)); do
		token=${arguments[i]}
		case "$token" in
			-v | --volume)
				i=$((i + 1))
				if [ "$i" -ge "${#arguments[@]}" ]; then
					echo 'Missing mount specification after volume flag.' >&2
					return 1
				fi
				spec=${arguments[i]}
				;;
			--volume=*) spec=${token#--volume=} ;;
			*) echo "Unsupported volume argument: $token" >&2; return 1 ;;
		esac
		if [[ "$spec" != *:* || "$spec" == *$'\n'* || "$spec" == *$'\r'* ]]; then
			echo 'A mount specification must be SOURCE:/absolute/target[:OPTIONS], without newlines.' >&2
			return 1
		fi
		source=${spec%%:*}
		target=${spec#*:}
		options='rw'
		if [[ "$target" == *:* ]]; then
			options=${target#*:}
			target=${target%%:*}
		fi
		if [[ -z "$source" || "$target" != /* || -z "$options" || "$options" == *[[:space:]:]* ]]; then
			echo "Invalid volume specification: $spec" >&2
			return 1
		fi
		target=$(realpath -ms -- "$target") || return 1
		if [ "$target" == '/' ]; then
			echo 'The container mount target cannot be /.' >&2
			return 1
		fi
		for other in "${mount_targets[@]}"; do
			if [ "$other" == "$target" ]; then
				echo "Duplicate container mount target: $target" >&2
				return 1
			fi
		done
		if [[ "$source" == /* ]]; then
			mount_kinds+=(bind)
		elif [[ "$source" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
			mount_kinds+=(named)
		else
			echo "Invalid mount source: $source" >&2
			return 1
		fi
		mount_sources+=("$source") mount_targets+=("$target") mount_options+=("$options")
	done
}

# $1: project name
function load_project_metadata() {
	local project_name=$1
	load_project_config "$project_name"
	# check if template exists
	if [ -z "$template" ]; then
		echo "please specify a template in project $project_name"
		exit -1
	elif [ ! -e "$template_path/$template" ]; then
		echo "template $template does not exist!"
		exit -1
	fi
	# load template metadata
	DISTRO_VARIANT='default'
	DISTRO_ARCHES=''
	DISTRO_TYPE='container'
	DISTRO_ROOTFS='rootfs.tar.xz'
	DISTRO_SHELL='/bin/bash'
	source "$template_path/$template"
	if [ "$DISTRO_TYPE" != 'container' ]; then
		echo "template $template is a $DISTRO_TYPE image and cannot run in Docker"
		exit 1
	fi
}

# $1: project name
function start_project() {
	local project_name=$1
	# load project metadata before creating Docker images
	load_project_metadata "$project_name"
	local -a mount_sources=() mount_targets=() mount_options=() mount_kinds=()
	parse_volume_mounts || exit 1
	local -a port_ips=() port_hosts=() port_containers=() port_protocols=()
	parse_port_mappings || exit 1
	validate_port_environment || exit 1
	# check if base image is ready
	create_base_image
	# check if rootfs exists
	if [ ! -d "$rootfs_dir" ]; then
		echo "rootfs directory does not exist!"
		exit -1
	fi
	# check if rootfs is complete
	if [ ! -f "$rootfs_dir/.buildenv" ]; then
		echo "rootfs is not complete, please init it first!"
		exit -1
	fi
	# generate rootfs mount option
	local entry f target overridden
	local -a rootfs_mounts=()
	# Keep /tmp ephemeral unless the project explicitly supplies its own mount.
	overridden=0
	for target in "${mount_targets[@]}"; do
		[ "$target" != /tmp ] || overridden=1
	done
	if [ "$overridden" -eq 0 ]; then
		rootfs_mounts+=(--tmpfs /tmp:rw,exec,nosuid,nodev,mode=1777)
	fi
	for entry in "$rootfs_dir/"*
	do
		[ -e "$entry" ] || [ -L "$entry" ] || continue
		f=${entry##*/}
		# this dirs will not be mount into container
		if [[ " $rootfs_blacklist " == *" $f "* ]]; then
			continue
		fi
		overridden=0
		for target in "${mount_targets[@]}"; do
			[ "$target" != "/$f" ] || overridden=1
		done
		[ "$overridden" -eq 0 ] || continue
		rootfs_mounts+=(-v "$rootfs_dir/$f:/$f")
	done

	# start container
	start_container "$base_image" "$name" "$extra_option" "${rootfs_mounts[@]}" "${volume[@]}" "${port[@]}"
}

function stop_project() {
	local project_name=$1
	# stop container
	if [ "x$project_name" == "x" ]; then
		echo 'please specify a valid project'
		show_all_projects
		exit -1
	fi
	stop_container $project_name
}

function get_arch() {
	local arch=$(uname -m)
	case "$arch" in
		x86_64) CPU_ARCH='amd64' ;;
		aarch64 | arm64) CPU_ARCH='arm64' ;;
		armv7l | armv8l) CPU_ARCH='armhf' ;;
		loongarch64) CPU_ARCH='loong64' ;;
		riscv64) CPU_ARCH='riscv64' ;;
		*)
			echo "unsupported host architecture: $arch"
			exit 1
			;;
	esac
}

# $1: distro name
# $2: distro version
# $3: image variant (default: default)
# $4: rootfs file (default: rootfs.tar.xz)
function download_image() {
	local distro_name=$1
	local distro_version=$2
	local distro_variant=${3:-default}
	local rootfs_file=${4:-rootfs.tar.xz}
	local rootfs_link=''
	local name version arch platform date path
	# get cpu arch of current machine
	get_arch
	# download index-system
	local index_link=$server/meta/1.0/index-system
	echo "download system index information from $index_link"
	wget --show-progress --no-check-certificate -q -O $tmp_dir/index-system $index_link
	if [ $? -ne 0 ]; then
		echo 'download failed, please check you internet connection!'
		rm -rf $tmp_dir
		exit -1
	fi
	# download rootfs tarball and extract it
	while IFS=';' read -r name version arch platform date path
	do
		if [ "$name" == "$distro_name" ] &&
			[ "$version" == "$distro_version" ] &&
			[ "$arch" == "$CPU_ARCH" ] &&
			[ "$platform" == "$distro_variant" ]; then
			rootfs_link="$server$path$rootfs_file"
			break
		fi
	done < $tmp_dir/index-system
	if [ -z "$rootfs_link" ]; then
		echo "no image found for $distro_name/$distro_version/$CPU_ARCH/$distro_variant"
		rm -rf "$tmp_dir"
		exit 1
	fi
	echo "download rootfs from $rootfs_link"
	wget --show-progress --no-check-certificate -q -O "$tmp_dir/$rootfs_file" "$rootfs_link"
	if [ $? -ne 0 ]; then
		echo 'download failed, please check you internet connection!'
		rm -rf $tmp_dir
		exit -1
	fi
	if [ "$rootfs_file" == 'rootfs.tar.xz' ]; then
		xz -d "$tmp_dir/rootfs.tar.xz" || exit 1
	fi
}

# Reuse the official Alpine helper image, pulling only when it is missing.
function bootstrap() {
	if docker image inspect "$bootstrap_image" &> /dev/null; then
		echo "bootstrap image $bootstrap_image is ready"
		return
	fi
	echo "pull bootstrap image $bootstrap_image from Docker Hub"
	docker pull "$bootstrap_image"
}

function create_base_image() {
	# check if base image exists
	docker image inspect $base_image &> /dev/null
	if [ $? -eq 0 ]; then
		echo 'buildenv base image is ready'
		return
	fi
	# init buildenv bootstrap image
	echo 'buildenv base image is not exist, create it'
	docker import - $base_image < /dev/null
}

# $1: project name
function init_project() {
	local project_name=$1
	local server='https://images.linuxcontainers.org'
	# Validate the image before downloading or creating Docker images.
	load_project_metadata "$project_name"
	rm -rf -- "$tmp_dir" && mkdir -- "$tmp_dir" || return 1
	# check if bootstrap is ready
	if ! bootstrap; then
		rm -rf -- "$tmp_dir"
		return 1
	fi
	# check if rootfs dir exists and empty
	if [ ! -d "$rootfs_dir" ]; then
		echo "rootfs directory '$rootfs_dir' does not exist!"
		rm -rf $tmp_dir
		exit -1
	elif ! directory_is_empty "$rootfs_dir"; then
		echo "rootfs directory '$rootfs_dir' is not empty!"
		rm -rf $tmp_dir
		exit -1
	fi
	download_image "$DISTRO_NAME" "$DISTRO_CODE" "$DISTRO_VARIANT" "$DISTRO_ROOTFS"
	# extract rootfs to rootfs directory, we use privileged
	# container to escalate to root permission
	echo "extracting rootfs to $rootfs_dir"
	local -a tmp_vol=(-v "$tmp_dir:/mnt/tmp" -v "$rootfs_dir:/mnt/rootfs")
	# 1. extract rootfs with root permission
	local cmd1='tar -xf /mnt/tmp/rootfs.tar -C /mnt/rootfs'
	if [ "$DISTRO_ROOTFS" == 'rootfs.squashfs' ]; then
		cmd1='apk add --no-cache squashfs-tools && unsquashfs -f -d /mnt/rootfs /mnt/tmp/rootfs.squashfs'
	fi
	# 2. let docker populate the dns server
	local cmd2='rm -f /mnt/rootfs/etc/resolv.conf'
	# 2. mark roofs as ready
	local cmd3='touch /mnt/rootfs/.buildenv'
	# 3. TODO gen post_init script
	local cmds="$cmd1 && $cmd2 && $cmd3"
	docker run --rm "${tmp_vol[@]}" "$bootstrap_image" /bin/sh -c "$cmds"
	if [ $? -ne 0 ]; then
		echo 'extract failed!'
		rm -rf $tmp_dir
		exit -1
	fi
	rm -rf $tmp_dir
	echo "init project $project_name success!"
}

# $1: project name
function clean_project() {
	local project_name=$1
	local ans
	# load project metadata before creating Docker images
	load_project_metadata "$project_name"
	# check if bootstrap is ready
	bootstrap || return 1
	read -r -p "will delete all files in $rootfs_dir! [Y/N]" ans
	if [ "$ans" == 'Y' ] || [ "$ans" == 'y' ]; then
		local -a tmp_vol=(-v "$rootfs_dir:/mnt/rootfs")
		local cmds='for entry in /mnt/rootfs/* /mnt/rootfs/.[!.]* /mnt/rootfs/..?*; do
			[ -e "$entry" ] || [ -L "$entry" ] || continue
			rm -rf -- "$entry" || exit 1
		done'
		if ! docker run --rm "${tmp_vol[@]}" "$bootstrap_image" /bin/sh -c "$cmds"; then
			echo "failed to clean project $project_name" >&2
			return 1
		fi
		echo "finish cleanup project $project_name"
	else
		echo 'canceled cleaning process'
	fi
}

function show_templates() {
	local data="Template:Distro:Version:Code:Variant:Type\n"
	for template_config in "$template_path/"*
	do
		[ -f "$template_config" ] || continue
		local t=${template_config##*/}
		DISTRO_VARIANT='default'
		DISTRO_TYPE='container'
		source "$template_config"
		data="$data$t:$DISTRO_NAME:$DISTRO_VERSION:$DISTRO_CODE:$DISTRO_VARIANT:$DISTRO_TYPE\n"
	done
	printf '%b' "$data" | column -t -s:
}

# $1: project config file name
# $2: command
function main() {
	local cmd=${1:-}
	local project=${2:-}

	# load project information if available
	case $cmd in
		'')
		show_help
		;;
		'create')
		if [ "$#" -gt 2 ]; then
			echo 'Usage: buildenv create [PROJECT]' >&2
			return 1
		fi
		if [ "$#" -eq 2 ]; then
			create_project "$project"
		else
			create_project
		fi
		;;
		'mount')
		if [ "$#" -gt 2 ]; then
			echo 'Usage: buildenv mount [PROJECT]' >&2
			return 1
		fi
		if [ "$#" -eq 2 ]; then
			mount_project "$project"
		else
			mount_project
		fi
		;;
		'port')
		if [ "$#" -gt 2 ]; then
			echo 'Usage: buildenv port [PROJECT]' >&2
			return 1
		fi
		if [ "$#" -eq 2 ]; then
			port_project "$project"
		else
			port_project
		fi
		;;
		'start')
		start_project "$project"
		;;
		'stop')
		stop_project "$project"
		;;
		'restart')
		stop_project "$project"
		start_project "$project"
		;;
		'clean')
		stop_project "$project"
		clean_project "$project"
		;;
		'init')
		init_project "$project"
		;;
		'status')
		list_container
		;;
		'template')
		show_templates
		;;
		'list')
		show_all_projects
		;;
		*)
		show_help
		;;
	esac
}

main "$@"
